# Copy to .env.local and fill in.

# AI parsing — Gemini (free): get a key at https://aistudio.google.com/apikey
# The free tier easily covers a COD funnel's daily parsing volume.
GEMINI_API_KEY=
# Optional override (default: gemini-2.5-flash-lite):
# GEMINI_MODEL=gemini-2.5-flash-lite

# Claude fallback — only used if GEMINI_API_KEY is not set.
# ANTHROPIC_API_KEY=sk-ant-...

# Supabase client settings are optional for legacy single-workspace development,
# but DATABASE_URL is required for tenant accounts and schema isolation.
# Use the service role key server-side only; never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Courier (Trans Express) — optional; booking runs in mock mode (fake waybill
# IDs) until COURIER_EMAIL + COURIER_PASSWORD are set. Auth is your Trans Express
# client login (email/password), which the app exchanges for a bearer token.
COURIER_NAME=Trans Express
COURIER_EMAIL=
COURIER_PASSWORD=
COURIER_WEBHOOK_SECRET=
CRON_SECRET=

# Optional overrides:
COURIER_API_URL=https://portal.transexpress.lk/api
COURIER_ITEM_DESCRIPTION=Merchandise
# Tracking endpoint (POST { waybill_id } with the bearer token). Default:
# COURIER_TRACKING_URL=https://portal.transexpress.lk/api/tracking
# Public full-history endpoint used to recover missed webhook events. Default:
# COURIER_PUBLIC_TRACKING_URL=https://api.transexpress.lk/api/v1/tracking
# Mock mode only: resolve parcels instantly instead of after ~2 days (for demos):
# COURIER_MOCK_FAST=true

# WhatsApp worker (worker/index.js). Defaults shown.
WA_WORKER_URL=http://localhost:3001
NEXT_PUBLIC_WA_WORKER_URL=http://localhost:3001
# Shared only by the web server and worker. The dashboard exchanges its login
# session for a short-lived worker token; never prefix this value NEXT_PUBLIC_.
WORKER_API_SECRET=
# Signs tenant/user login sessions. Use a different random value from all
# webhook secrets. APP_PASSWORD is accepted only as a legacy fallback.
SESSION_SECRET=
# Seed/migrate the existing single-operator workspace into the public legacy
# tenant on first login.
ADMIN_EMAIL=owner@example.com
DEFAULT_TENANT_SLUG=daily-cart
DEFAULT_TENANT_NAME=Daily Cart
# Public self-service workspace creation is off by default in production.
ALLOW_SIGNUP=false
# One deployed worker manager supervises this many simultaneous WhatsApp
# sessions. Increase together with VM memory after measuring real usage.
WA_MAX_TENANTS=10
# In production, lets the always-on worker run tracking + reminder delivery
# using the same CRON_SECRET as the web app. The worker drains the WhatsApp
# outbox every 2 minutes (so time-scheduled reminders fire on time) and runs the
# full courier reconciliation every 10 minutes.
# APP_TRACKING_CRON_URL=https://your-app.example.com/api/tracking/cron
# TRACKING_DRAIN_INTERVAL_MS=120000
# TRACKING_SYNC_INTERVAL_MS=600000
# The follow-up engine's heartbeat. This is the ONLY scheduler for follow-ups:
# there is deliberately no Vercel cron for them, because a Hobby account allows
# at most one cron run per day and a once-daily tick would send exactly one
# follow-up per day. The always-on worker is what paces them properly.
# Each tick sends at most one follow-up, so this interval IS the pacing — cold
# leads are chased as a slow trickle instead of a burst, which is what keeps an
# unofficial WhatsApp connection safe. The worker adds up to 45s of random
# jitter so sends never land on a visible grid.
# Defaults to APP_URL + /api/followups/tick; set the URL only to override.
# APP_FOLLOWUP_CRON_URL=https://your-app.example.com/api/followups/tick
# FOLLOWUP_TICK_INTERVAL_MS=150000
# How long one tracking sync may run before deferring the rest to the next run.
# Keep below the platform's function timeout.
# TRACKING_SYNC_BUDGET_MS=45000

# Guard against talking over yourself: a customer gets at most one message of
# the same kind per order per this many hours, however many times the courier
# revises the delivery. Owner alerts are exempt. Set 0 to disable.
# CUSTOMER_NOTIFICATION_COOLDOWN_HOURS=12

# Autonomous sales agent. APP_URL is the public Next.js origin that the
# WhatsApp worker calls after a debounced inbound message. Use the same random
# secret in both services in production.
APP_URL=http://localhost:3000
AGENT_WEBHOOK_SECRET=
# Optional worker-side debounce for customers who send several short bubbles.
# AI_REPLY_DEBOUNCE_MS=1200

# Operator login — set this before deploying anywhere public. When set, every
# page and API route requires this password once per browser (30-day cookie).
# Leave unset for open local dev.
# APP_PASSWORD=
